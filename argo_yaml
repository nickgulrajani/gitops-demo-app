apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: hello-gitops
  namespace: argocd
spec:
  project: default

  destination:
    namespace: default
    server: https://kubernetes.default.svc

  source:
    repoURL: https://github.com/nickgulrajani/gitops-demo-app.git
    targetRevision: main
    path: .

  syncPolicy:
    automated:
      prune: true
      selfHeal: true

